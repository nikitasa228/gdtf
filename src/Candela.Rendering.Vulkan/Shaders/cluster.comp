#version 460
#extension GL_GOOGLE_include_directive : require
// Clustered light assignment. One work group per cluster (CLUSTER_COUNT_X x _Y screen tiles x _Z logarithmic depth
// slices) writes the cluster's light mask: thread t builds mask words t, t + CLUSTER_THREADS, ... (32 lights each,
// tested against the cluster's view-space bounds), then the summary words (one bit per non-empty mask word) - no
// global atomics, and the result does not depend on thread scheduling. A list holds every one of the
// frame.clusterListedLights listed lights (frame.clusterMaskWords x 32 bits), however many reach the cluster; lights
// beyond that (more lights than the renderer's clustered-light limit) are only tested, so the clusters that miss one
// are counted. The statistics block gets the cluster-light pairs, the busiest cluster and the overflowed clusters for
// the CPU.

#define CLUSTER_BUFFERS_WRITABLE
#include "scene.glsl"
#include "view.glsl"
#include "photometry.glsl"

layout(local_size_x = CLUSTER_THREADS) in;

shared uint sSummary[MAX_CLUSTER_SUMMARY_WORDS];
shared uint sCount;
shared uint sOverflow;

// View-space bounds (camera at the origin looking down -Z) of cluster (x, y, z).
void clusterBounds(uint index, out vec3 bmin, out vec3 bmax)
{
    uint x = index % frame.clusterCountX;
    uint y = (index / frame.clusterCountX) % frame.clusterCountY;
    uint z = index / (frame.clusterCountX * frame.clusterCountY);
    float d0 = exp((float(z) - frame.clusterLogBias) / frame.clusterLogScale);
    float d1 = exp((float(z + 1u) - frame.clusterLogBias) / frame.clusterLogScale);
    if (z == 0u)
        d0 = 0.0; // fragments nearer than the first slice boundary are clamped into slice 0
    if (z + 1u == frame.clusterCountZ)
        d1 = 1e9; // ... and those beyond the last boundary into the last slice
    vec2 ndc0 = vec2(x, y) / vec2(frame.clusterCountX, frame.clusterCountY) * 2.0 - 1.0;
    vec2 ndc1 = vec2(x + 1u, y + 1u) / vec2(frame.clusterCountX, frame.clusterCountY) * 2.0 - 1.0;
    vec2 invScale = vec2(1.0 / frame.projection[0][0], 1.0 / frame.projection[1][1]);
    bool ortho = isOrthographic();
    bmin = vec3(1e30);
    bmax = vec3(-1e30);
    for (int i = 0; i < 2; ++i)
    {
        float d = i == 0 ? d0 : d1;
        float s = ortho ? 1.0 : d;
        vec2 a = ndc0 * invScale * s;
        vec2 b = ndc1 * invScale * s;
        bmin = min(bmin, vec3(min(a, b), -d));
        bmax = max(bmax, vec3(max(a, b), -d));
    }
}

// Conservative test of a light's cone (cut-off angle, range) against the cluster bounds.
bool lightTouches(Light light, vec3 bmin, vec3 bmax)
{
    vec3 position = (frame.view * vec4(light.position, 1.0)).xyz;
    vec3 direction = normalize(mat3(frame.view) * light.direction);
    float rangeSq = lightRangeSquared(light);
    vec3 nearest = clamp(position, bmin, bmax);
    vec3 delta = nearest - position;
    if (dot(delta, delta) > rangeSq)
        return false;
    float cosA = clamp(light.cosCutoff, -1.0, 1.0);
    if (cosA <= 0.0)
        return true; // cones of 90 degrees or more: the range test is all we do
    float sinA = sqrt(1.0 - cosA * cosA);
    vec3 centre = 0.5 * (bmin + bmax);
    float radius = 0.5 * length(bmax - bmin);
    vec3 v = centre - position;
    float along = dot(v, direction);
    float across = sqrt(max(dot(v, v) - along * along, 0.0));
    if (cosA * across - along * sinA > radius)
        return false; // bounding sphere entirely outside the cone
    return along >= -radius; // not entirely behind the light
}

void main()
{
    uint cluster = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationIndex;
    uint words = min(frame.clusterMaskWords, uint(MAX_CLUSTER_SUMMARY_WORDS) * 32u);
    uint summaryWords = (words + 31u) / 32u;
    uint base = cluster * (summaryWords + words);
    uint listed = min(min(frame.lightCount, frame.clusterListedLights), words * 32u);

    for (uint s = tid; s < summaryWords; s += CLUSTER_THREADS)
        sSummary[s] = 0u;
    if (tid == 0u)
    {
        sCount = 0u;
        sOverflow = 0u;
    }
    barrier();

    vec3 bmin, bmax;
    clusterBounds(cluster, bmin, bmax);

    uint count = 0u;
    for (uint w = tid; w < words; w += CLUSTER_THREADS)
    {
        uint first = w * 32u;
        uint n = first < listed ? min(32u, listed - first) : 0u;
        uint bits = 0u;
        for (uint b = 0u; b < n; ++b)
        {
            if (lightTouches(lights[first + b], bmin, bmax))
                bits |= 1u << b;
        }

        clusterMasks[base + summaryWords + w] = bits;
        if (bits != 0u)
        {
            atomicOr(sSummary[w >> 5u], 1u << (w & 31u));
            count += uint(bitCount(bits));
        }
    }

    // Unlisted lights (beyond the clustered-light limit): the cluster misses them; only find out whether one reaches it.
    bool missed = false;
    for (uint i = listed + tid; i < frame.lightCount && !missed; i += CLUSTER_THREADS)
        missed = lightTouches(lights[i], bmin, bmax);

    if (count > 0u)
        atomicAdd(sCount, count);
    if (missed)
        atomicOr(sOverflow, 1u);
    barrier();

    for (uint s = tid; s < summaryWords; s += CLUSTER_THREADS)
        clusterMasks[base + s] = sSummary[s];
    if (tid == 0u)
    {
        uint total = sCount;
        clusters[cluster] = uvec2(total, sOverflow);
        if (total > 0u)
        {
            atomicAdd(clusterLightPairs, total);
            atomicMax(clusterMaxLights, total);
        }
        if (sOverflow != 0u)
            atomicAdd(clusterOverflow, 1u);
    }
}
