#version 460
#extension GL_GOOGLE_include_directive : require
// Bloom downsampling (Jimenez 2014, "Next generation post processing in Call of Duty"): each level is the previous one
// (the HDR image for the first level) filtered with the 13-tap pattern of five overlapping 4x4 box filters (weights
// 0.5 for the centre box, 0.125 for the four corner boxes) at half resolution. The filter is normalised, so every
// level keeps the image's total energy. Variant FIRST reads the HDR image; it limits the (pre-exposed) luma of each
// sample to FIREFLY_LUMA, 10 stops above display white, so a stray half-float overflow or a sub-pixel specular glint
// cannot flood the pyramid. Unlike a Karis average this leaves the energy of everything below that limit untouched.

#include "view.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = SET_PASS, binding = BINDING_PASS_STORAGE0, rgba16f) uniform writeonly image2D outLevel;
#ifndef FIRST
layout(set = SET_PASS, binding = BINDING_PASS_SAMPLED0) uniform sampler2D sourceLevel;
#endif

const float FIREFLY_LUMA = 1024.0;

vec3 fetch(vec2 uv)
{
#ifdef FIRST
    // Filtered in the shader from four texels made finite first (common.glsl), never by the texture unit: an HDR texel
    // that overflowed to +infinity would come out of hardware bilinear filtering as NaN (0 x inf, inf - inf) and spread
    // through the whole pyramid as dark blocks of every level's size around a bright lens. The filtered sample is then
    // limited, as before, so a lens of a few texels still blooms with the energy of its filtered footprint.
    vec3 c = sampleLightBilinear(hdrTexture, uv);
    float luma = dot(c, vec3(0.2627, 0.6780, 0.0593));
    return luma > FIREFLY_LUMA ? c * (FIREFLY_LUMA / luma) : c;
#else
    return textureLod(sourceLevel, uv, 0.0).rgb;
#endif
}

vec2 sourceTexel()
{
#ifdef FIRST
    return 1.0 / vec2(textureSize(hdrTexture, 0));
#else
    return 1.0 / vec2(textureSize(sourceLevel, 0));
#endif
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outLevel);
    if (any(greaterThanEqual(p, size)))
        return;
    vec2 t = sourceTexel();
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    vec3 a = fetch(uv + t * vec2(-2.0, -2.0));
    vec3 b = fetch(uv + t * vec2(0.0, -2.0));
    vec3 c = fetch(uv + t * vec2(2.0, -2.0));
    vec3 d = fetch(uv + t * vec2(-1.0, -1.0));
    vec3 e = fetch(uv + t * vec2(1.0, -1.0));
    vec3 f = fetch(uv + t * vec2(-2.0, 0.0));
    vec3 g = fetch(uv);
    vec3 h = fetch(uv + t * vec2(2.0, 0.0));
    vec3 i = fetch(uv + t * vec2(-1.0, 1.0));
    vec3 j = fetch(uv + t * vec2(1.0, 1.0));
    vec3 k = fetch(uv + t * vec2(-2.0, 2.0));
    vec3 l = fetch(uv + t * vec2(0.0, 2.0));
    vec3 m = fetch(uv + t * vec2(2.0, 2.0));

    vec3 centre = (d + e + i + j) * 0.25;
    vec3 corners = (a + b + f + g) + (b + c + g + h) + (f + g + k + l) + (g + h + l + m);
    vec3 result = centre * 0.5 + corners * (0.125 * 0.25);
    imageStore(outLevel, p, vec4(finiteLight(result), 1.0));
}
