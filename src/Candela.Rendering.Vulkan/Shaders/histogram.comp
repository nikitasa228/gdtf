#version 460
#extension GL_GOOGLE_include_directive : require
// Auto exposure, step 1: histogram of log2 scene luminance (cd/m2: HDR / exposure) over HISTOGRAM_BINS bins between
// HISTOGRAM_MIN_LOG2 and HISTOGRAM_MAX_LOG2, accumulated in shared memory per 16 x 16 tile and added to the view's
// exposure buffer (cleared every frame).

#include "view.glsl"
#include "color.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = SET_VIEW, binding = BINDING_EXPOSURE, scalar) buffer ExposureBuffer
{
    uint histogram[HISTOGRAM_BINS];
    float averageLog2Luminance;
    uint pixelCount;
    uint exposurePad0;
    uint exposurePad1;
};

shared uint sBins[HISTOGRAM_BINS];

void main()
{
    uint tid = gl_LocalInvocationIndex;
    if (tid < HISTOGRAM_BINS)
        sBins[tid] = 0u;
    barrier();

    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(frame.renderSize.xy);
    if (all(lessThan(p, size)))
    {
        vec3 hdr = finiteLight(texelFetch(hdrTexture, p, 0).rgb);
        float luminance = max(luminanceRec2020(hdr), 0.0) / max(frame.exposure, 1e-30);
        float x = (log2(max(luminance, 1e-12)) - HISTOGRAM_MIN_LOG2) / (HISTOGRAM_MAX_LOG2 - HISTOGRAM_MIN_LOG2);
        uint bin = uint(clamp(x * float(HISTOGRAM_BINS), 0.0, float(HISTOGRAM_BINS - 1u)));
        atomicAdd(sBins[bin], 1u);
    }

    barrier();
    if (tid < HISTOGRAM_BINS && sBins[tid] > 0u)
        atomicAdd(histogram[tid], sBins[tid]);
}
