#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
// Ray-traced one-bounce diffuse GI at reduced resolution (devices with ray query). Every pixel traces RT_RAYS
// cosine-distributed rays from the surface under it against the TLAS of the scene's instances; at a hit the reflected
// direct light of the view's shadowed lights (shadow maps give the visibility) and the emission are evaluated:
//   L_hit = albedo / pi x sum_j E_j(hit) + L_emissive,     E_indirect = pi / N x sum T_haze(t) L_hit      [lx]
// (cosine-weighted estimator); misses see the background luminance. The noisy estimate is blended with the previous
// frame's result reprojected to this surface (exponential moving average, rejected where the depth disagrees).
// draw.mode = number of GI lights in raymarchList after the ray-marched beams; draw.width = history weight.

#define RT_GEOMETRY_SET SET_PASS
#define RT_GEOMETRY_BINDING BINDING_PASS_BUFFER
#include "lighting.glsl"
#include "rt_geometry.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = SET_PASS, binding = BINDING_PASS_STORAGE0, rgba16f) uniform writeonly image2D outIndirect;
layout(set = SET_PASS, binding = BINDING_PASS_SAMPLED0) uniform sampler2D historyIndirect;
layout(set = SET_PASS, binding = BINDING_PASS_TLAS) uniform accelerationStructureEXT sceneTlas;

const uint RT_RAYS = 4u;
const float RT_MAX_DISTANCE = 100.0;

vec3 cosineDirection(vec3 N, float u1, float u2)
{
    float r = sqrt(u1);
    float phi = 2.0 * PI * u2;
    vec3 T = abs(N.z) < 0.999 ? normalize(cross(N, vec3(0.0, 0.0, 1.0))) : normalize(cross(N, vec3(1.0, 0.0, 0.0)));
    vec3 B = cross(N, T);
    return normalize(T * (r * cos(phi)) + B * (r * sin(phi)) + N * sqrt(max(1.0 - u1, 0.0)));
}

// Reflected + emitted luminance (cd/m2, Rec.2020) at a ray hit.
vec3 shadeHit(uint instance, uint geometry, uint primitive, vec2 bary, vec3 rayDir, uint giLights)
{
    RtSurface surface = rtFetchSurface(instance, geometry, primitive, bary);
    vec3 P = surface.position;
    vec3 N = surface.normal;
    if (dot(N, rayDir) > 0.0)
        N = -N;
    vec2 uv = surface.uv;
    Material m = materials[surface.material];
    vec3 albedo = m.baseColor.rgb;
    if ((m.flags & MATERIAL_BASE_COLOR_TEXTURE) != 0u)
        albedo = rec709ToRec2020(textureLod(textures[nonuniformEXT(m.baseColorTexture)], uv * m.uvScale, 0.0).rgb * m.baseColorFactor709.rgb);
    albedo *= 1.0 - clamp(m.metallic, 0.0, 1.0);

    vec3 E = vec3(0.0);
    for (uint j = 0u; j < giLights; ++j)
    {
        uint index = raymarchList[frame.beamCount + j];
        Light light = lights[index];
        vec3 L;
        float d2;
        vec3 I = lightIntensityToward(light, P, 0.0, L, d2);
        float cosI = dot(N, L);
        if (cosI <= 0.0 || I.r + I.g + I.b <= 0.0)
            continue;
        E += I * (cosI * shadowHard(lightViews[index].shadowSlot, P, N) / d2);
    }

    // The instance emission (lens glow) is not added: it is what the camera sees of a light the spot light already
    // emits.
    return albedo * INV_PI * E + m.emissive;
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outIndirect);
    if (any(greaterThanEqual(p, size)))
        return;
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    ivec2 full = min(ivec2(uv * frame.renderSize.xy), ivec2(frame.renderSize.xy) - 1);
    float d = texelFetch(sceneDepth, full, 0).r;
    if (d <= 0.0)
    {
        imageStore(outIndirect, p, vec4(0.0, 0.0, 0.0, frame.volumeDepth.y));
        return;
    }

    vec2 centre = (vec2(full) + 0.5) * frame.renderSize.zw;
    vec3 P = worldFromDepth(centre, d);
    vec3 N = decodeNormal(texelFetch(sceneNormals, full, 0).rg);
    float viewDepth = viewDepthOf(P);
    vec3 origin = P + N * max(1e-3, 1e-4 * viewDepth);
    vec3 sky = frame.background.rgb / max(frame.exposure, 1e-30);
    uint seed = uint(p.x) * 73856093u ^ uint(p.y) * 19349663u ^ frame.frameIndex * 83492791u;
    vec3 sum = vec3(0.0);
    for (uint r = 0u; r < RT_RAYS; ++r)
    {
        vec3 dir = cosineDirection(N, hashToUnit(seed + 2u * r), hashToUnit(seed ^ (0x68bc21ebu + 2u * r + 1u)));
        rayQueryEXT query;
        rayQueryInitializeEXT(query, sceneTlas, gl_RayFlagsOpaqueEXT, RT_MASK_SCENE, origin, 0.0, dir, RT_MAX_DISTANCE);
        while (rayQueryProceedEXT(query))
        {
        }

        if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
        {
            uint instance = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, true));
            uint geometry = uint(rayQueryGetIntersectionGeometryIndexEXT(query, true));
            uint primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(query, true));
            vec2 bary = rayQueryGetIntersectionBarycentricsEXT(query, true);
            float hitDistance = rayQueryGetIntersectionTEXT(query, true);
            sum += shadeHit(instance, geometry, primitive, bary, dir, draw.mode) * lightPathTransmittance(hitDistance);
        }
        else
        {
            sum += sky;
        }
    }

    vec3 E = PI * sum / float(RT_RAYS);
    float historyWeight = draw.width;
    if (historyWeight > 0.0)
    {
        vec4 clip = frame.previousViewProjection * vec4(P, 1.0);
        if (clip.w > 1e-6)
        {
            // P lies under a full-resolution pixel centre; shift by its offset from this pixel's centre so that a
            // still camera reads exactly this texel of the history (no drift or blur through repeated filtering).
            vec2 prevUv = clip.xy / clip.w * 0.5 + 0.5 + (uv - centre);
            float prevDepth = isOrthographic() ? viewDepth : clip.w;
            if (all(greaterThanEqual(prevUv, vec2(0.0))) && all(lessThanEqual(prevUv, vec2(1.0))))
            {
                vec4 h = textureLod(historyIndirect, prevUv, 0.0);
                if (abs(h.a - prevDepth) < 0.05 * prevDepth && all(equal(h, h)))
                    E = mix(E, h.rgb, historyWeight);
            }
        }
    }

    imageStore(outIndirect, p, vec4(finiteLight(E), viewDepth));
}
