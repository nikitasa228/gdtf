#version 460
#extension GL_GOOGLE_include_directive : require
// Per-pixel single scattering of the volumetric beams, at half the internal resolution. For every beam whose bit is
// set in the pixel's tile mask and every prism facet of it, the view ray is clipped analytically to the facet's
// truncated cone (starting at the lens disc) and to the scene depth, and
//   L = integral of sigma_s x HG(g, cos) x I(theta) x cookie x shadow x T_light / d^2 x T_view dt
// is evaluated in two parts:
//  - far field (z >= zNear, the lens no longer matters): the light is a point source. With the substitution
//    t = t_c + D tan(gamma) the 1/d^2 singularity disappears (dt / d^2 = dgamma / D), and in chord coordinates of
//    the great circle the ray is a straight line through the beam's angular profile, whose integral comes from the
//    precomputed table H(v, y) (BeamScatteringTable.cs). The smooth factor m(gamma) = HG x T_light x T_view is
//    multiplied in per segment (product integration with K segments, K from the angle the ray sweeps): exact,
//    noise-free soft edges for uniform haze without cookie or shadow. Where gobos, blades, shadow maps or smoke
//    density matter, one stratified, blue-noise-jittered sample per segment measures the modulation (cookie x shadow
//    x local scattering coefficient x exact/table profile ratio) of that segment's share of the integral;
//  - near field (z < zNear = 3 R / tan(half-angle)): the lens is an extended source; the shaft starts with the lens
//    radius R and blends into the point-source cone (radius (R^4 + (z tan)^4)^(1/4), flux conserved), integrated with
//    Gauss-Legendre nodes (cookie, shadow and smoke evaluated at the nodes).
// Outputs (pre-exposed): rgb of outScatter = L; rgb of outBase = the same integral without modulation, with the
// reference scattering coefficient (frame.beamSigmaRef): the noise-free envelope the temporal pass multiplies its
// accumulated modulation ratio L / B with, so moving beams never smear. outBase.a = view depth of the pixel's
// representative sample (checkerboard of the nearest and farthest depth of its 2 x 2 block); outScatter.a = the
// depth for which L is valid in the depth-aware upsampling: that view depth when a beam reaches the surface,
// otherwise minus the view depth at which the last beam along the ray ended (L holds for every surface behind it, so
// a beam in front of a depth edge stays continuous across it).

#include "beam.glsl"
#include "volume.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = SET_PASS, binding = BINDING_PASS_STORAGE0, rgba16f) uniform writeonly image2D outScatter;
layout(set = SET_PASS, binding = BINDING_PASS_STORAGE1, rgba16f) uniform writeonly image2D outBase;
// Line integrals of the beam profiles: RG16F (hi, lo) of H(v, y); x = y, y = v, z = layer (family x exponent).
layout(set = SET_PASS, binding = BINDING_PASS_SAMPLED0) uniform sampler3D beamTable;

// Gauss-Legendre 4-point rule on [-1, 1].
const float GL_X[4] = float[](-0.86113631159405, -0.33998104358486, 0.33998104358486, 0.86113631159405);
const float GL_W[4] = float[](0.34785484513745, 0.65214515486255, 0.65214515486255, 0.34785484513745);

// Largest change of the scattering angle within one far-field segment (rad): the phase function, the 1/d^2
// substitute and the transmittances vary smoothly on this scale.
const float GAMMA_STEP = 0.1;

// Most far-field segments and cookie samples per beam crossing at full quality (scaled by frame.beamQuality).
const int MAX_SEGMENTS = 8;
const int MAX_COOKIE_SAMPLES = 24;

// Near field length in units of the apex offset R / tan(half-angle): (1 + 3^-4)^(-1/4) = 0.997 of the point source.
const float NEAR_FIELD_SPAN = 3.0;

struct BeamRay
{
    vec3 origin;
    vec3 dir;
    float tMax;        // scene depth along the ray (m)
    vec2 uv;           // normalised screen position
    float originDepth; // view depth of the origin
    float stretch;     // ray length per metre of view depth
    float noise;       // blue-noise value of the pixel, [0, 1)
    float pixelSize;   // world size of a pixel per metre of view depth (perspective) or constant (orthographic)
    bool mediaVolume;  // smoke or flames: view transmittance from the froxel volume
};

// Position of a chord line in the table: the two v rows around it and the weight of the second.
struct TableRow
{
    float layer;
    float v0;
    float f;
};

TableRow tableRow(float layer, float v)
{
    float fv = clamp(v, 0.0, 1.0) * float(BEAM_TABLE_V_STEPS - 1);
    float v0 = min(floor(fv), float(BEAM_TABLE_V_STEPS - 2));
    return TableRow(layer, v0, fv - v0);
}

// One table entry at exact (y, v) texel centres; the hardware interpolates only between the exponent layers, whose
// weight is the same for the whole beam. Interpolation in y and v is done by the caller in full precision: texture
// filter weights have only about 8 fractional bits, which shows as stripes in smooth beams.
float tableAt(TableRow row, float vIndex, float yIndex)
{
    vec3 coord = vec3((yIndex + 0.5) / float(BEAM_TABLE_Y_STEPS),
                      (vIndex + 0.5) / float(BEAM_TABLE_V_STEPS),
                      (row.layer + 0.5) / float(BEAM_TABLE_LAYERS));
    vec2 h = textureLod(beamTable, coord, 0.0).rg;
    return h.x + h.y;
}

// H(v, y): integral of the normalised profile along the chord line at distance v, from 0 to y (odd in y), bilinear
// between the table entries.
float profileIntegral(Light light, TableRow row, float v, float y)
{
    float ay = abs(y);
    float h;
    if (light.shape == SHAPE_UNIFORM_CONE)
    {
        h = min(ay, sqrt(max(1.0 - v * v, 0.0)));
    }
    else
    {
        float fy = min(ay, 1.0) * float(BEAM_TABLE_Y_STEPS - 1);
        float i0 = min(floor(fy), float(BEAM_TABLE_Y_STEPS - 2));
        float a = mix(tableAt(row, row.v0, i0), tableAt(row, row.v0 + 1.0, i0), row.f);
        float b = mix(tableAt(row, row.v0, i0 + 1.0), tableAt(row, row.v0 + 1.0, i0 + 1.0), row.f);
        h = mix(a, b, fy - i0);
    }

    return y < 0.0 ? -h : h;
}

// The beam shape without the iris (what the table integrates), at angle theta (rad) from the facet axis.
float shapeProfile(Light light, float theta)
{
    if (light.shape == SHAPE_UNIFORM_CONE)
        return theta * light.invHalfBeam <= 1.0 ? 1.0 : 0.0;
    if (theta >= light.cutoff)
        return 0.0;
    float r = theta * light.invHalfBeam;
    float g = r > 0.0 ? exp(-LN2 * exp(light.exponent * log(r))) : 1.0;
    if (theta > light.halfField)
    {
        float s = (theta - light.halfField) * light.invWindow;
        g *= 1.0 - s * s * (3.0 - 2.0 * s);
    }

    return g;
}

// View-path transmittance from the camera to distance t along the ray.
float viewTransmittance(BeamRay ray, float t)
{
    if (ray.mediaVolume)
        return sampleIntegratedVolume(ray.uv, ray.originDepth + t / ray.stretch).a;
    return hasFeature(FEATURE_HAZE) ? exp(-frame.media.x * t) : 1.0;
}

// Cookie (gobo x framing blades, Rec.2020 transmission) of facet k towards the unit world direction omega leaving the
// light; footprint = filter radius in gate units.
vec3 facetCookie(Light light, uint k, uint facets, vec3 omega, float footprint)
{
    if ((light.flags & (LIGHT_GOBO | LIGHT_BLADES)) == 0u)
        return vec3(1.0);
    vec3 v = beamToFacet(light, k, facets, vec3(dot(omega, light.right), dot(omega, light.up), dot(omega, light.direction)));
    if (v.z <= 1e-6)
        return vec3(0.0);
    vec2 p = v.xy * (light.gateScale / v.z);
    float t = 1.0;
    if ((light.flags & LIGHT_BLADES) != 0u)
        t = bladeTransmission(light, p, light.edgeSoftness + footprint);
    if (t <= 0.0)
        return vec3(0.0);
    vec3 c = vec3(t);
    if ((light.flags & LIGHT_GOBO) != 0u)
        c *= goboTransmission(light, p, footprint);
    return c;
}

// Smoke scattering coefficient (1/m) at P, without the uniform haze.
float smokeAt(vec3 P)
{
    vec3 uvw;
    if (hasFeature(FEATURE_SMOKE) && boxCoordinates(P, frame.smokeMin, frame.smokeMax, uvw))
        return max(textureLod(smokeTexture, uvw, 0.0).r, 0.0) * frame.media.z;
    return 0.0;
}

// Transmittance of the smoke between the light at L (smoke smokeL there) and X (smoke smokeX): Simpson's rule over
// the two ends and the midpoint, so a light path that crosses a cloud between them is dimmed too.
float smokeLightTransmittance(vec3 L, vec3 X, float smokeL, float smokeX)
{
    float smokeMid = smokeAt(0.5 * (L + X));
    float depth = (smokeL + 4.0 * smokeMid + smokeX) * (1.0 / 6.0) * distance(L, X);
    return depth > 0.0 ? exp(-depth) : 1.0;
}

// Pseudo-random stratum offset in [0, 1) of sample i of a beam crossing (blue-noise pixel value + R1 sequence).
float stratum(BeamRay ray, uint salt, int i)
{
    return fract(ray.noise + float(i) * 0.6180339887 + float(salt) * 0.7548776662);
}

// Smooth factor of the far-field integrand at table coordinate y of a ray (great circle phi, D, tc): phase function x
// light-path and view-path transmittance x range window x du/dy (the chord-to-arc Jacobian). 0 at infinity.
float smoothFactor(BeamRay ray, float phi, float D, float tc, float y, float yScale, float g, float rangeSq)
{
    float u = 2.0 * asin(clamp(y / (2.0 * yScale), -1.0, 1.0));
    float gamma = phi + u;
    float c = cos(gamma);
    if (c <= 1e-6)
        return 0.0;
    float t = tc + D * tan(gamma);
    float r = D / c;
    return henyeyGreenstein(-sin(gamma), g) * lightPathTransmittance(r) * viewTransmittance(ray, t) * rangeWindow(r * r, rangeSq) /
           cos(0.5 * u);
}

// Far field of facet k (point source, axis a, half-angle halfAngle), between zNear and the light's range.
void farField(Light light, uint slot, uint salt, uint k, uint facets, vec3 a, float halfAngle, float zNear, BeamRay ray, bool modulate,
              int samples, float smokeAtLight, inout vec3 sumL, inout float sumB, inout float tEnd)
{
    float range = beamRange(light);
    float t0, t1;
    if (!beamConeInterval(ray.origin, ray.dir, light.position, a, cos(halfAngle), zNear, max(range, zNear * 1.0001), ray.tMax, t0, t1))
        return;
    tEnd = max(tEnd, t1);

    // Closest approach of the ray's line to the light: the great circle of directions and its parametrisation.
    vec3 p = ray.origin - light.position;
    float tc = -dot(p, ray.dir);
    vec3 xc = p + tc * ray.dir;
    float D = length(xc);
    vec3 n;
    if (D > 1e-6)
    {
        n = xc / D;
    }
    else
    {
        vec3 helper = abs(ray.dir.z) < 0.9 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
        n = normalize(cross(ray.dir, helper));
    }

    D = max(D, 1e-5);
    float A = dot(n, a);
    float Bd = dot(ray.dir, a);
    float e = dot(a, cross(n, ray.dir));
    float R = clamp(sqrt(A * A + Bd * Bd), 1e-4, 1.0);
    float phi = atan(Bd, A);

    // Table coordinates: chord units scaled by the chord of the table's unit radius (the cut-off).
    bool cone = light.shape == SHAPE_UNIFORM_CONE;
    float thetaB = 1.0 / max(light.invHalfBeam, 1e-6);
    float W = cone ? 1.0 : light.cutoff * light.invHalfBeam;
    float scale = 2.0 * sin(0.5 * thetaB) * W;
    float v = sqrt(2.0 * e * e / (1.0 + R)) / scale;
    float support = 1.0;
    if (light.irisAngle < 3.9)
        support = min(support, 2.0 * sin(0.25 * (light.irisSoftStart + light.irisAngle)) / scale);
    if (v >= support)
        return;
    float ySupport = sqrt(support * support - v * v);
    float yScale = sqrt(R) / scale;
    float g0 = atan((t0 - tc) / D);
    float g1 = atan((t1 - tc) / D);
    float ya = max(2.0 * yScale * sin(0.5 * (g0 - phi)), -ySupport);
    float yb = min(2.0 * yScale * sin(0.5 * (g1 - phi)), ySupport);
    if (!(yb > ya))
        return;

    // Segments: the same number for every ray through this beam (from the largest angle a ray can sweep inside it,
    // twice the half-angle), so the result has no seams where a per-pixel count would change. Cookies with detail get
    // more modulation samples per segment instead of more segments.
    int K = clamp(int(ceil(2.0 * halfAngle / GAMMA_STEP)), 2, max(2, int(float(MAX_SEGMENTS) * frame.beamQuality + 0.5)));
    int perSegment = samples;
    if (modulate && (light.flags & (LIGHT_GOBO | LIGHT_BLADES)) != 0u)
    {
        float gateSpan = (yb - ya) * scale * light.gateScale;
        int detail = int(ceil(6.0 * gateSpan));
        int pixels = int(ceil((t1 - t0) / max(ray.pixelSize * max(ray.originDepth + 0.5 * (t0 + t1) / ray.stretch, 1e-3), 1e-6)));
        int cap = max(2, int(float(MAX_COOKIE_SAMPLES) * frame.beamQuality + 0.5));
        int wanted = clamp(min(detail, max(pixels, 2)), 2, cap);
        perSegment = samples * max(1, (wanted + K - 1) / K);
    }

    float layer = light.beamLayer;
    float g = frame.media.y;
    float sigmaH = hasFeature(FEATURE_HAZE) ? frame.media.x : 0.0;
    float rangeSq = lightRangeSquared(light);
    float dy = (yb - ya) / float(K);
    // Cookie filter: the gate-plane length one modulation sample stands for.
    float footprint = 0.5 * dy / float(perSegment) * scale * light.gateScale;
    TableRow row = tableRow(layer, v);
    float mChord2 = 2.0 * e * e / (1.0 + R);
    float profileScale = thetaB * W;

    // Product integration with the smooth factor m(y) = HG x T_light x T_view x range window x du/dy linear on each
    // segment: integral of m x profile = dH x ((1 - lambda) m(y0) + lambda m(y1)), lambda = the profile's centroid
    // in the segment (Simpson's rule on the profile). Second order in the segment length, so the strongly forward-
    // peaked phase function needs no more segments.
    float yPrev = ya;
    float hPrev = profileIntegral(light, row, v, yPrev);
    float mPrev = smoothFactor(ray, phi, D, tc, yPrev, yScale, g, rangeSq);
    float fPrev = shapeProfile(light, profileScale * sqrt(v * v + yPrev * yPrev));
    vec3 accL = vec3(0.0);
    float accB = 0.0;
    for (int i = 0; i < K; ++i)
    {
        float yNext = ya + float(i + 1) * dy;
        float hNext = profileIntegral(light, row, v, yNext);
        float mNext = smoothFactor(ray, phi, D, tc, yNext, yScale, g, rangeSq);
        float fNext = shapeProfile(light, profileScale * sqrt(v * v + yNext * yNext));
        float yMid = yPrev + 0.5 * dy;
        float fMid = shapeProfile(light, profileScale * sqrt(v * v + yMid * yMid));
        float dH = hNext - hPrev;
        float simpson = fPrev + 4.0 * fMid + fNext;
        float lambda = simpson > 1e-6 ? (2.0 * fMid + fNext) / simpson : 0.5;
        float w = max(dH, 0.0) * mix(mPrev, mNext, lambda);
        hPrev = hNext;
        mPrev = mNext;
        fPrev = fNext;
        yPrev = yNext;
        if (!(w > 0.0))
            continue;
        accB += w;
        if (!modulate)
        {
            accL += vec3(w * sigmaH);
            continue;
        }

        vec3 modulation = vec3(0.0);
        for (int s = 0; s < perSegment; ++s)
        {
            float xi = fract(stratum(ray, salt, i) + float(s) / float(perSegment));
            float yj = ya + (float(i) + xi) * dy;
            float uj = 2.0 * asin(clamp(yj / (2.0 * yScale), -1.0, 1.0));
            float gj = phi + uj;
            float cj = cos(gj);
            if (cj <= 1e-6)
                continue;
            float tj = tc + D * tan(gj);
            float rj = D / cj;
            vec3 X = ray.origin + ray.dir * tj;
            vec3 omega = n * cj + ray.dir * sin(gj);
            float smoke = smokeAt(X);
            float sigma = sigmaH + smoke;
            if (sigma <= 0.0)
                continue;
            // Smoke along the light path.
            float smokeLight = hasFeature(FEATURE_SMOKE) ? smokeLightTransmittance(light.position, X, smokeAtLight, smoke) : 1.0;
            // Exact profile (iris included) against the table's chord approximation at this point.
            float chord = sqrt(mChord2 + R * 4.0 * sin(0.5 * uj) * sin(0.5 * uj));
            float exact = beamProfile(light, 2.0 * asin(min(0.5 * chord, 1.0)));
            float approx = shapeProfile(light, profileScale * sqrt(v * v + yj * yj));
            float ratio = approx > 1e-4 ? clamp(exact / approx, 0.0, 4.0) : 1.0;
            float shadow = shadowHard(slot, X, vec3(0.0));
            float pixelGate = ray.pixelSize * max(ray.originDepth + tj / ray.stretch, 0.0) / max(rj, 1e-3) * light.gateScale;
            vec3 c = facetCookie(light, k, facets, omega, max(footprint, pixelGate));
            modulation += c * (sigma * ratio * shadow * smokeLight);
        }

        accL += w * modulation / float(perSegment);
    }

    float factor = scale / (D * sqrt(R));
    sumL += light.intensity * (accL * factor);
    sumB += accB * factor;
}

// Near field of facet k: the lens disc of radius R as an extended source, blending into the point source.
void nearField(Light light, uint slot, uint k, uint facets, vec3 a, float halfAngle, float zNear, BeamRay ray, bool modulate,
               float smokeAtLight, inout vec3 sumL, inout float sumB, inout float tEnd)
{
    float lens = light.sourceRadius;
    float offset = beamApexOffset(lens, halfAngle);
    float t0, t1;
    if (!beamConeInterval(ray.origin, ray.dir, light.position - a * offset, a, cos(halfAngle), offset, offset + zNear, ray.tMax, t0, t1))
        return;
    tEnd = max(tEnd, t1);
    float tanHalf = tan(halfAngle);
    float g = frame.media.y;
    float sigmaH = hasFeature(FEATURE_HAZE) ? frame.media.x : 0.0;
    float rangeSq = lightRangeSquared(light);
    float lens4 = lens * lens * lens * lens;
    int pieces = clamp(int(ceil((t1 - t0) / max(2.0 * lens, 1e-3))), 1, 3);
    float half_ = 0.5 * (t1 - t0) / float(pieces);
    vec3 accL = vec3(0.0);
    float accB = 0.0;
    for (int piece = 0; piece < pieces; ++piece)
    {
        float centre = t0 + (2.0 * float(piece) + 1.0) * half_;
        for (int j = 0; j < 4; ++j)
        {
            float t = centre + GL_X[j] * half_;
            vec3 X = ray.origin + ray.dir * t;
            vec3 rel = X - light.position;
            float z = dot(rel, a);
            if (z <= 1e-6)
                continue;
            vec3 radial = rel - a * z;
            float zeta = z * tanHalf;
            float s = zeta / sqrt(sqrt(lens4 + zeta * zeta * zeta * zeta));
            vec3 scaled = a * z + radial * s;
            float r2 = dot(scaled, scaled);
            vec3 omega = scaled * inversesqrt(r2);
            float theta = atan(length(radial) * s, z);
            float f = beamProfile(light, theta);
            if (f <= 0.0)
                continue;
            float d = length(rel);
            float m = henyeyGreenstein(dot(omega, -ray.dir), g) * lightPathTransmittance(d) * viewTransmittance(ray, t) * rangeWindow(d * d, rangeSq);
            float w = GL_W[j] * half_ * f * s * s / r2 * m;
            accB += w;
            if (!modulate)
            {
                accL += vec3(w * sigmaH);
                continue;
            }

            float smoke = smokeAt(X);
            float sigma = sigmaH + smoke;
            if (sigma <= 0.0)
                continue;
            float smokeLight = hasFeature(FEATURE_SMOKE) ? smokeLightTransmittance(light.position, X, smokeAtLight, smoke) : 1.0;
            float shadow = shadowHard(slot, X, vec3(0.0));
            float pixelGate = ray.pixelSize * max(ray.originDepth + t / ray.stretch, 0.0) / max(d, 1e-3) * light.gateScale;
            accL += w * sigma * shadow * smokeLight * facetCookie(light, k, facets, omega, pixelGate);
        }
    }

    sumL += light.intensity * accL;
    sumB += accB;
}

void main()
{
    ivec2 size = imageSize(outScatter);
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(id, size)))
        return;

    // Representative internal pixel of the 2 x 2 block: the nearest surface on even, the farthest on odd pixels, so
    // the depth-aware upsampling finds a matching sample on both sides of depth edges.
    ivec2 renderSize = ivec2(frame.renderSize.xy);
    ivec2 base = id * 2;
    bool nearest = ((id.x + id.y) & 1) == 0;
    ivec2 pick = min(base, renderSize - 1);
    float depth = texelFetch(sceneDepth, pick, 0).r;
    for (int j = 0; j < 2; ++j)
    {
        for (int i = 0; i < 2; ++i)
        {
            ivec2 q = min(base + ivec2(i, j), renderSize - 1);
            float d = texelFetch(sceneDepth, q, 0).r;
            if (nearest ? d > depth : d < depth)
            {
                depth = d;
                pick = q;
            }
        }
    }

    // The ray goes through the centre of the block (a regular grid for the upsampling); it ends at the view depth of
    // the chosen pixel.
    BeamRay ray;
    ray.uv = min(vec2(base) + 1.0, frame.renderSize.xy) * frame.renderSize.zw;
    viewRay(ray.uv, ray.origin, ray.dir);
    ray.stretch = 1.0 / max(dot(ray.dir, frame.cameraForward.xyz), 1e-4);
    ray.originDepth = viewDepthOf(ray.origin);
    float viewDepth = depth > 0.0 ? viewDepthOf(worldFromDepth((vec2(pick) + 0.5) * frame.renderSize.zw, depth)) : frame.volumeDepth.y;
    ray.tMax = max(viewDepth - ray.originDepth, 0.0) * ray.stretch;

    // Interleaved gradient noise over the half-resolution grid (well spread within every 3 x 3 neighbourhood), advanced
    // by the golden ratio per frame: each pixel's sample positions form an R1 sequence over time, so the temporal
    // accumulation sees evenly stratified samples (shifting the noise pattern instead advances every pixel by nearly
    // one half per frame, and the average stalls at two positions).
    ray.noise = fract(interleavedGradientNoise(vec2(id)) + float(frame.frameIndex % 64u) * 0.6180339887);
    ray.pixelSize = isOrthographic() ? frame.pixelFootprint.y : frame.pixelFootprint.x;
    ray.mediaVolume = hasFeature(FEATURE_SMOKE) || hasFeature(FEATURE_FLAME);
    // Without a history the frame stands alone: twice the modulation samples.
    int samples = (frame.beamFlags & BEAM_FLAG_HISTORY) != 0u ? 1 : 2;

    vec3 L = vec3(0.0);
    vec3 B = vec3(0.0);
    // Farthest distance along the ray at which a beam contributed.
    float tEnd = 0.0;
    uint words = frame.beamWordsPerTile;
    uint tile = uint(id.y / BEAM_TILE_SIZE) * frame.beamTiles.x + uint(id.x / BEAM_TILE_SIZE);
    uint maskBase = BEAM_MASK_HEADER + tile * words;
    bool smoke = hasFeature(FEATURE_SMOKE);
    for (uint w = 0u; w < words; ++w)
    {
        uint bits = beamMasks[maskBase + w];
        while (bits != 0u)
        {
            int b = findLSB(bits);
            bits &= bits - 1u;
            uint entry = w * 32u + uint(b);
            uint index = raymarchList[entry];
            Light light = lights[index];
            uint slot = lightViews[index].shadowSlot;
            bool shadowed = slot != NO_SHADOW && hasFeature(FEATURE_SHADOWS);
            bool modulate = shadowed || smoke || (light.flags & (LIGHT_GOBO | LIGHT_BLADES)) != 0u;
            uint facets = beamFacetCount(light);
            float halfAngle = beamFacetHalfAngle(light);
            float zNear = light.sourceRadius > 0.0 ? NEAR_FIELD_SPAN * beamApexOffset(light.sourceRadius, halfAngle) : 0.0;
            vec3 sumL = vec3(0.0);
            float sumB = 0.0;
            float smokeAtLight = smoke ? smokeAt(light.position) : 0.0;
            for (uint k = 0u; k < facets; ++k)
            {
                vec3 a = beamFacetAxis(light, k, facets);
                farField(light, slot, entry, k, facets, a, halfAngle, zNear, ray, modulate, samples, smokeAtLight, sumL, sumB, tEnd);
                if (zNear > 0.0)
                    nearField(light, slot, k, facets, a, halfAngle, zNear, ray, modulate, smokeAtLight, sumL, sumB, tEnd);
            }

            L += sumL;
            B += light.intensity * sumB;
        }
    }

    // Validity depth for the upsampling: when every beam ended in front of the surface (or no beam was hit), the
    // value holds for any surface behind that point, stored negated; otherwise only for this sample's surface depth.
    bool clipped = tEnd >= ray.tMax * 0.9999 && tEnd > 0.0;
    float validity = clipped ? viewDepth : -max(ray.originDepth + tEnd / ray.stretch, 1e-4);
    imageStore(outScatter, id, vec4(finiteLight(L * frame.exposure), validity));
    imageStore(outBase, id, vec4(finiteLight(B * (frame.beamSigmaRef * frame.exposure)), viewDepth));
}
