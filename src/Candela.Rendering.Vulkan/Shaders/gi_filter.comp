#version 460
#extension GL_GOOGLE_include_directive : require
// Edge-aware spatial filter of the ray-traced indirect irradiance (one a-trous iteration, Dammertz et al. 2010): a
// 5 x 5 B3-spline kernel with taps draw.mode texels apart, weighted by
//   depth:  exp(-|z_q - z_p| / (FILTER_DEPTH_SIGMA x z_p x step))  (relative view-depth difference),
//   normal: max(n_p . n_q, 0)^FILTER_NORMAL_POWER                    (pre-pass normals under the texels),
// so irradiance is averaged along surfaces but not across silhouettes or creases. Two iterations (steps 1 and 2)
// give a footprint of about 2.2 half-resolution texels standard deviation: enough to remove most of the remaining
// Monte Carlo noise after temporal accumulation without washing out the fall-off of indirect light near its source
// (wider kernels need luminance edge-stopping from a variance estimate). The kernel is normalised by the sum of its
// weights, so a smooth irradiance field keeps its value (and its energy). alpha = view depth (passed on).

#include "view.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = SET_PASS, binding = BINDING_PASS_STORAGE0, rgba16f) uniform writeonly image2D outIndirect;
layout(set = SET_PASS, binding = BINDING_PASS_SAMPLED0) uniform sampler2D inIndirect;

const float FILTER_DEPTH_SIGMA = 0.02;
const float FILTER_NORMAL_POWER = 32.0;

vec3 normalUnder(ivec2 texel, ivec2 size)
{
    vec2 uv = (vec2(texel) + 0.5) / vec2(size);
    ivec2 full = min(ivec2(uv * frame.renderSize.xy), ivec2(frame.renderSize.xy) - 1);
    return decodeNormal(texelFetch(sceneNormals, full, 0).rg);
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outIndirect);
    if (any(greaterThanEqual(p, size)))
        return;
    vec4 centre = texelFetch(inIndirect, p, 0);
    float z = centre.a;
    ivec2 full = min(ivec2((vec2(p) + 0.5) / vec2(size) * frame.renderSize.xy), ivec2(frame.renderSize.xy) - 1);
    if (!(z > 0.0) || texelFetch(sceneDepth, full, 0).r <= 0.0)
    {
        // Background: nothing to filter.
        imageStore(outIndirect, p, centre);
        return;
    }

    int step = max(int(draw.mode), 1);
    vec3 n = normalUnder(p, size);
    const float kernel[3] = float[](0.375, 0.25, 0.0625);
    vec3 sum = vec3(0.0);
    float weightSum = 0.0;
    for (int dy = -2; dy <= 2; ++dy)
    {
        for (int dx = -2; dx <= 2; ++dx)
        {
            ivec2 q = p + ivec2(dx, dy) * step;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size)))
                continue;
            vec4 s = texelFetch(inIndirect, q, 0);
            float w = kernel[abs(dx)] * kernel[abs(dy)];
            if (dx != 0 || dy != 0)
            {
                w *= exp(-abs(s.a - z) / (FILTER_DEPTH_SIGMA * z * float(step)));
                w *= pow(max(dot(n, normalUnder(q, size)), 0.0), FILTER_NORMAL_POWER);
            }

            if (!(w > 0.0) || !allFinite(s))
                continue;
            sum += s.rgb * w;
            weightSum += w;
        }
    }

    imageStore(outIndirect, p, vec4(finiteLight(sum / max(weightSum, 1e-12)), z));
}
