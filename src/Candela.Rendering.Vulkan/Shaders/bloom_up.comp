#version 460
#extension GL_GOOGLE_include_directive : require
// Bloom upsampling: level i += 3x3 tent-filtered level i + 1 (in place). After the whole chain level 0 holds the sum
// of all levels, each a progressively wider normalised blur of the image; the display transform divides by the
// number of levels, so the bloom image has the same total energy as the scene and (1 - k) scene + k bloom only
// redistributes light.

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = SET_PASS, binding = BINDING_PASS_STORAGE0, rgba16f) uniform image2D level;
layout(set = SET_PASS, binding = BINDING_PASS_SAMPLED0) uniform sampler2D coarser;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(level);
    if (any(greaterThanEqual(p, size)))
        return;
    vec2 t = 1.0 / vec2(textureSize(coarser, 0));
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    vec3 sum = textureLod(coarser, uv, 0.0).rgb * 4.0;
    sum += (textureLod(coarser, uv + vec2(-t.x, 0.0), 0.0).rgb + textureLod(coarser, uv + vec2(t.x, 0.0), 0.0).rgb +
            textureLod(coarser, uv + vec2(0.0, -t.y), 0.0).rgb + textureLod(coarser, uv + vec2(0.0, t.y), 0.0).rgb) * 2.0;
    sum += textureLod(coarser, uv + vec2(-t.x, -t.y), 0.0).rgb + textureLod(coarser, uv + vec2(t.x, -t.y), 0.0).rgb +
           textureLod(coarser, uv + vec2(-t.x, t.y), 0.0).rgb + textureLod(coarser, uv + vec2(t.x, t.y), 0.0).rgb;
    vec4 current = imageLoad(level, p);
    imageStore(level, p, vec4(current.rgb + sum / 16.0, 1.0));
}
