; Messages during installation
LangString MsgCloseCandela ${LANG_ENGLISH} "Candela is running. Please close it (save your work first), then click Retry."
LangString MsgCloseCandela ${LANG_RUSSIAN} "Candela запущена. Закройте её (сначала сохраните работу) и нажмите «Повтор»."
LangString MsgRemovingPrevious ${LANG_ENGLISH} "Removing the previous version (your settings are kept)…"
LangString MsgRemovingPrevious ${LANG_RUSSIAN} "Удаление предыдущей версии (настройки сохраняются)…"
LangString MsgRemovedPrevious ${LANG_ENGLISH} "Previous version removed"
LangString MsgRemovedPrevious ${LANG_RUSSIAN} "Предыдущая версия удалена"
LangString MsgVcPresent ${LANG_ENGLISH} "The Microsoft Visual C++ runtime is already installed"
LangString MsgVcPresent ${LANG_RUSSIAN} "Среда выполнения Microsoft Visual C++ уже установлена"
LangString MsgVcInstalling ${LANG_ENGLISH} "Installing the Microsoft Visual C++ 2015-2022 runtime (x64)…"
LangString MsgVcInstalling ${LANG_RUSSIAN} "Установка среды выполнения Microsoft Visual C++ 2015-2022 (x64)…"
LangString MsgVcDone ${LANG_ENGLISH} "Microsoft Visual C++ runtime installed"
LangString MsgVcDone ${LANG_RUSSIAN} "Среда выполнения Microsoft Visual C++ установлена"
LangString MsgVcFailed ${LANG_ENGLISH} "The Microsoft Visual C++ runtime could not be installed"
LangString MsgVcFailed ${LANG_RUSSIAN} "Не удалось установить среду выполнения Microsoft Visual C++"
LangString MsgVcNotStarted ${LANG_ENGLISH} "its setup could not be started"
LangString MsgVcNotStarted ${LANG_RUSSIAN} "её установщик не запустился"
LangString MsgVcFailedBox ${LANG_ENGLISH} "The Microsoft Visual C++ 2015-2022 runtime (x64) could not be installed. Candela's editor needs it.$\r$\n$\r$\nPlease install it from https://aka.ms/vs/17/release/vc_redist.x64.exe and start Candela again."
LangString MsgVcFailedBox ${LANG_RUSSIAN} "Не удалось установить среду выполнения Microsoft Visual C++ 2015-2022 (x64). Она нужна редактору Candela.$\r$\n$\r$\nУстановите её с https://aka.ms/vs/17/release/vc_redist.x64.exe и запустите Candela снова."
LangString MsgNeeds64Bit ${LANG_ENGLISH} "Candela needs 64-bit Windows 10 or 11."
LangString MsgNeeds64Bit ${LANG_RUSSIAN} "Для Candela нужна 64-битная Windows 10 или 11."
LangString MsgNeedsWindows10 ${LANG_ENGLISH} "Candela needs Windows 10 or 11 (64-bit)."
LangString MsgNeedsWindows10 ${LANG_RUSSIAN} "Для Candela нужна Windows 10 или 11 (64-бит)."
LangString MsgDowngrade ${LANG_ENGLISH} "A newer version of Candela ($PreviousVersion) is installed. Replace it with ${VERSION}?"
LangString MsgDowngrade ${LANG_RUSSIAN} "Установлена более новая версия Candela ($PreviousVersion). Заменить её версией ${VERSION}?"

; Uninstaller
LangString SecRemoveSettings ${LANG_ENGLISH} "Also remove my settings, caches and logs"
LangString SecRemoveSettings ${LANG_RUSSIAN} "Удалить также мои настройки, кэш и журналы"
LangString UnSecProgramDescription ${LANG_ENGLISH} "The program files, shortcuts, file associations and the firewall rule."
LangString UnSecProgramDescription ${LANG_RUSSIAN} "Файлы программы, ярлыки, сопоставления файлов и правило брандмауэра."
LangString UnSecSettingsDescription ${LANG_ENGLISH} "Your settings and layouts (%APPDATA%\Candela) and the caches, autosaves and logs (%LOCALAPPDATA%\Candela). Your projects and your fixture library folder are never removed."
LangString UnSecSettingsDescription ${LANG_RUSSIAN} "Ваши настройки и раскладки окон (%APPDATA%\Candela), а также кэш, автосохранения и журналы (%LOCALAPPDATA%\Candela). Ваши проекты и папка библиотеки приборов не удаляются никогда."
