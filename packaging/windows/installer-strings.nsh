LangString ArpComment ${LANG_ENGLISH} "Stage lighting visualiser (preview)"
LangString ArpComment ${LANG_RUSSIAN} "Визуализатор сценического света (предварительная версия)"

; Finish page
LangString FinishRun ${LANG_ENGLISH} "Start Candela"
LangString FinishRun ${LANG_RUSSIAN} "Запустить Candela"
LangString FinishReadme ${LANG_ENGLISH} "Show the read-me file"
LangString FinishReadme ${LANG_RUSSIAN} "Показать файл «Прочтите»"
