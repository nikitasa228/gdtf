LangString ShortcutPromptDescription ${LANG_RUSSIAN} "Командная строка, в которой можно запускать утилиту candela"
LangString ShortcutReadme ${LANG_ENGLISH} "Read Me"
LangString ShortcutReadme ${LANG_RUSSIAN} "Прочтите"
LangString ShortcutDocs ${LANG_ENGLISH} "Documentation"
LangString ShortcutDocs ${LANG_RUSSIAN} "Документация"
