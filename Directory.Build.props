<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Authors>Candela contributors</Authors>
    <Product>Candela</Product>
  </PropertyGroup>
  <!--
    The version of Candela: the one place to change it. Assemblies, the Windows file properties of candela-app.exe and
    candela.exe, the About window, the installer (Candela-Setup-<version>-win-x64.exe) and its Add/Remove Programs entry
    all read it from here (packaging/windows/build-installer.* ask MSBuild for $(Version) and $(FileVersion)).
    A preview build is CandelaVersion-preview.CandelaPreview; an empty CandelaPreview makes a release version.
    The fourth number of the Windows file version is the preview number (1-999) and 1000 for the release, so a release
    sorts after its previews: the installer compares it to refuse a silent downgrade and to upgrade in place.
  -->
  <PropertyGroup>
    <CandelaVersion>0.1.0</CandelaVersion>
    <CandelaPreview>1</CandelaPreview>
    <VersionPrefix>$(CandelaVersion)</VersionPrefix>
    <VersionSuffix Condition="'$(CandelaPreview)' != ''">preview.$(CandelaPreview)</VersionSuffix>
    <AssemblyVersion>$(CandelaVersion).0</AssemblyVersion>
    <FileVersion Condition="'$(CandelaPreview)' != ''">$(CandelaVersion).$(CandelaPreview)</FileVersion>
    <FileVersion Condition="'$(CandelaPreview)' == ''">$(CandelaVersion).1000</FileVersion>
    <Company>Candela contributors</Company>
    <Copyright>© 2026 Candela contributors</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
