<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- graphics / windowing / UI -->
    <PackageVersion Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Shaderc" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
    <PackageVersion Include="Hexa.NET.GLFW" Version="1.0.5" />
    <PackageVersion Include="Hexa.NET.ImGui" Version="2.2.9" />
    <PackageVersion Include="Hexa.NET.ImGuizmo" Version="2.2.9" />
    <PackageVersion Include="Hexa.NET.ImGui.Backends" Version="1.0.18" />
    <PackageVersion Include="Hexa.NET.ImGui.Backends.GLFW" Version="1.0.18" />
    <!-- assets -->
    <PackageVersion Include="AssimpNet" Version="5.0.0-beta1" />
    <PackageVersion Include="SharpGLTF.Core" Version="1.0.7" />
    <PackageVersion Include="StbImageSharp" Version="2.30.16" />
    <PackageVersion Include="StbImageWriteSharp" Version="1.16.7" />
    <!-- tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>
</Project>
